# Leave everything below unset and the app runs in DEMO MODE with
# pre-rendered looks — no key needed.
#
# The app talks to Gemini OR OpenAI, picked by AI_PROVIDER. Only set
# the key(s) for the provider(s) you'll actually use.

# Which engine to use. "gemini" or "openai".
# Leave unset and it auto-picks: Gemini if GEMINI_API_KEY is set,
# else OpenAI if OPENAI_API_KEY is set, else demo mode.
AI_PROVIDER=

# ---- Gemini -----------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3-flash

# ---- OpenAI -------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
# Needs a funded account — image generation has no free tier.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini
# "1024x1024" | "1024x1536" | "1536x1024" | "auto"
OPENAI_IMAGE_SIZE=1024x1024
# "low" | "medium" | "high" | "auto" — higher costs more, looks better
OPENAI_IMAGE_QUALITY=medium

# ---- Shared ---------------------------------------------------------
# "premium" = 3-pass body lock (read -> generate -> verify). "simple" = 1 call.
TRYON_MODE=premium
