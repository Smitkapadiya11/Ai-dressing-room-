# Required to run the fitting engine and scripts/build-catalogue.mjs.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Run scripts/probe-gemini.mjs once, then set whichever shape it says
# answered. "A" (classic generateContent) is the default if you leave
# this unset.
GEMINI_API_SHAPE=A

# THE BIGGEST COST LEVER. 512px=Rs4.30 (testing only), 1K=Rs6.41 (ship on
# this), 2K=Rs9.66 (only if you can see the difference on the totem).
RESULT_SIZE=1K

# Optional override for scripts/build-catalogue.mjs
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional — shown on the Poster and welcome screen. Defaults to "Kapadiya & Sons"
NEXT_PUBLIC_SHOP_NAME=
