# Only needed to run scripts/build-catalogue.mjs (the paid photo fallback).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override for scripts/build-catalogue.mjs
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional — shown on the Poster and welcome screen. Defaults to "Kapadiya & Sons"
NEXT_PUBLIC_SHOP_NAME=
