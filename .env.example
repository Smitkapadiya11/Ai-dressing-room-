# Get a key at https://aistudio.google.com/apikey
# Leave this unset and the app runs in DEMO MODE with pre-rendered looks.
GEMINI_API_KEY=

# Optional overrides
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3-flash
# "premium" = 3-pass body lock (read -> generate -> verify). "simple" = 1 call.
TRYON_MODE=premium
