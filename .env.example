# PROVIDER-AGNOSTIC — lib/imagegen.js is the only file that reads this.
# "openai" is the default. Run scripts/bakeoff.mjs with a real photo
# before deciding — look at your own face, not a benchmark.
PROVIDER=openai

# test = gpt-image-1-mini, Rs 1.58/image (default — iterate cheaply)
# demo = gpt-image-2.5/gpt-image-2 fallback chain, Rs 4.78/image (ship on this)
RESULT_TIER=test

# --- OpenAI (PROVIDER=openai) ---
OPENAI_API_KEY=
# Optional overrides — comma-separated fallback chains, tried in order.
# OPENAI_IMAGE_MODEL_TEST=gpt-image-1-mini
# OPENAI_IMAGE_MODEL_DEMO=gpt-image-2.5,gpt-image-2,gpt-image-1.5
# OPENAI_TEXT_MODEL=gpt-4o-mini,gpt-4.1-mini

# --- Gemini (PROVIDER=gemini) ---
GEMINI_API_KEY=
# Run scripts/probe-gemini.mjs once, then set whichever shape it says
# answered. "A" (classic generateContent) is the default if unset.
GEMINI_API_SHAPE=A

# --- Qwen-Image-2.1 (PROVIDER=qwen) ---
# Runs via the local Qwen-Image-2.1 API server (or custom remote URL)
QWEN_API_URL=http://127.0.0.1:8000

# Optional — shown on the Poster and welcome screen. Defaults to "Kapadiya & Sons"
NEXT_PUBLIC_SHOP_NAME=

# SiliconFlow cloud engines (shown in the kiosk Engine drawer when set)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODELS=black-forest-labs/FLUX.2-flex,black-forest-labs/FLUX.2-pro
SILICONFLOW_PRICE_INR=0
# Engine used when the drawer isn't touched: house (= PROVIDER) or sf:<model>
TRYON_DEFAULT_ENGINE=house
